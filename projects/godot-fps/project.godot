; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but for District 187 Tactical FPS base we configure standard controls.

config_version=5

[application]

config/name="District Tactical FPS"
config/description="Tactical First-Person Shooter engine based on reverse-engineered District 187 mechanics, assets, and balance data."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

